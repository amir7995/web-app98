{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app98",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f5629035-7bb3-4f2c-a54a-f5a77412d227","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "87c976de026748bb8fa6658b769f6391" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
